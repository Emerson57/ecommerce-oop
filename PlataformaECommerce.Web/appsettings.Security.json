{
  "Jwt": {
    "Issuer": "PlataformaECommerce.Web",
    "Audience": "PlataformaECommerce.Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "RequireHttpsMetadata": true
  },
  "AuthenticationCookies": {
    "SessionIdleTimeoutMinutes": 480,
    "PersistentSessionAbsoluteLifetimeHours": 24,
    "SlidingExpiration": true,
    "SameSite": "Lax",
    "SecurePolicy": "Always",
    "HttpOnly": true,
    "SharedCookieDomain": null,
    "IsEssential": true
  },
  "TransportSecurity": {
    "HstsEnabled": true,
    "HstsMaxAgeDays": 30,
    "IncludeSubDomains": false,
    "Preload": false
  },
  "OpenApiSecurity": {
    "EnabledInDevelopment": true,
    "EnabledInQualityAssurance": false,
    "EnabledInProduction": false,
    "RequireAuthorizationOutsideDevelopment": true,
    "RequiredPolicy": "SuperUserOnly"
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": {
      "Enabled": true,
      "UseReportOnlyInDevelopment": false,
      "IncludeUpgradeInsecureRequests": true,
      "DefaultSources": [ "'self'" ],
      "BaseUriSources": [ "'self'" ],
      "ObjectSources": [ "'none'" ],
      "FrameAncestorSources": [ "'none'" ],
      "ImageSources": [ "'self'", "data:", "https:" ],
      "StyleSources": [ "'self'" ],
      "ScriptSources": [ "'self'" ],
      "FontSources": [ "'self'", "data:" ],
      "ConnectSources": [ "'self'" ],
      "FormActionSources": [ "'self'" ]
    },
    "PermissionsPolicy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "FrameOptions": "DENY",
    "ContentTypeOptions": "nosniff",
    "CrossOriginOpenerPolicy": "same-origin",
    "CrossOriginResourcePolicy": "same-site"
  },
  "Antiforgery": {
    "CookieName": "__Host-PlataformaECommerce.Antiforgery",
    "FormFieldName": "__RequestVerificationToken",
    "HeaderName": "RequestVerificationToken",
    "SuppressXFrameOptionsHeader": true
  },
  "ForwardedHeadersSecurity": {
    "Enabled": false,
    "ForwardLimit": 1,
    "RequireHeaderSymmetry": true,
    "TrustForwardedHost": false,
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "AllowedHosts": []
  }
}
