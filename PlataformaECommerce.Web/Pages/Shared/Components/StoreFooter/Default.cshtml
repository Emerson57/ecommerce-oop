@model PlataformaECommerce.Web.ViewComponents.StoreFooterViewComponent.StoreFooterViewModel

<div>
    <h4>@Model.BrandName</h4>
    <p>
        @Model.BrandTagline
    </p>
    <div class="small text-muted d-flex flex-column gap-1">
        <span><strong>Soporte:</strong> @Model.SupportEmail</span>
        <span><strong>Teléfono:</strong> @Model.SupportPhone</span>
        <span><strong>Horario:</strong> @Model.SupportHours</span>
    </div>
</div>

<div>
    <h5>Explora</h5>
    @foreach (var link in Model.ExploreLinks)
    {
        <a asp-area="" asp-page="@link.Page" asp-all-route-data="@link.RouteValues">@link.Text</a>
    }
</div>

<div>
    <h5>Categorías</h5>
    @if (Model.CategoryLinks.Count == 0)
    {
        <span class="footer-placeholder">Categorías disponibles próximamente</span>
    }
    else
    {
        @foreach (var link in Model.CategoryLinks)
        {
            <a asp-area="" asp-page="@link.Page" asp-all-route-data="@link.RouteValues">@link.Text</a>
        }
    }
</div>

<div>
    <h5>Accesos</h5>
    @foreach (var link in Model.AccessLinks)
    {
        <a asp-area="" asp-page="@link.Page" asp-all-route-data="@link.RouteValues" class="@(link.IsMuted ? "footer-link-muted" : string.Empty)">@link.Text</a>
    }
</div>
