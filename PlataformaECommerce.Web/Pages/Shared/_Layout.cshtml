<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NovaShop</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlataformaECommerce.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="site-wrapper">
        <header class="store-header">
            <div class="top-header">
                <div class="container">
                    <div class="top-header-content">
                        <a class="store-logo" asp-area="" asp-page="/Index">
                            <span class="logo-mark">N</span>
                            <span class="logo-text">NovaShop</span>
                        </a>

                        <form class="header-search" role="search">
                            <input type="text" placeholder="Buscar productos, marcas y categorías..." />
                            <button type="submit">Buscar</button>
                        </form>

                        <div class="header-actions">
                            <a asp-page="/Cuenta/Ingresar" class="header-action">Iniciar sesión</a>
                            <a asp-page="/Cuenta/Registro" class="header-action">Crear cuenta</a>
                            <a asp-page="/Carrito/Index" class="header-action cart-action">Carrito (2)</a>

                            <button type="button" id="themeToggle" class="theme-toggle-btn" title="Cambiar tema">
                                <span id="themeToggleText">🌞 Claro</span>
                            </button>

                            <button type="button" id="mobileMenuToggle" class="mobile-menu-btn" aria-label="Abrir menú">
                                ☰
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="category-nav-wrapper">
                <div class="container">
                    <nav class="category-nav" id="categoryNav">
                        <a asp-area="" asp-page="/Index">Inicio</a>
                        <a href="#">Nuevos ingresos</a>
                        <a href="#">Ofertas</a>
                        <a href="#">Tecnología</a>
                        <a href="#">Hogar</a>
                        <a href="#">Moda</a>
                        <a href="#">Deportes</a>
                        <a asp-area="" asp-page="/Cuenta/Ingresar">Mi cuenta</a>
                        <a asp-area="" asp-page="/Carrito/Index">Carrito</a>
                    </nav>
                </div>
            </div>
        </header>

        <main class="main-content">
            @RenderBody()
        </main>

        <footer class="store-footer">
            <div class="container">
                <div class="footer-grid">
                    <div>
                        <h4>NovaShop</h4>
                        <p>
                            Una experiencia de compra moderna, segura y pensada para ofrecer productos,
                            promociones atractivas y una navegación clara.
                        </p>
                    </div>

                    <div>
                        <h5>Compra</h5>
                        <a href="#">Nuevos ingresos</a>
                        <a href="#">Ofertas</a>
                        <a href="#">Categorías</a>
                        <a href="#">Más vendidos</a>
                    </div>

                    <div>
                        <h5>Mi cuenta</h5>
                        <a asp-page="/Cuenta/Ingresar">Iniciar sesión</a>
                        <a asp-page="/Cuenta/Registro">Crear cuenta</a>
                        <a asp-page="/Carrito/Index">Carrito</a>
                    </div>

                    <div>
                        <h5>Empresa</h5>
                        <a href="#">Nosotros</a>
                        <a asp-area="" asp-page="/Privacy">Privacidad</a>
                        <a href="#">Términos</a>
                        <a href="#">Contacto</a>
                    </div>
                </div>

                <div class="footer-bottom">
                    <span>© 2026 NovaShop. Todos los derechos reservados.</span>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>