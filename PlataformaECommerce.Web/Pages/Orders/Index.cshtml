@page
@using PlataformaECommerce.Domain.Enums
@model PlataformaECommerce.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Mis pedidos";
}

<div class="container py-5">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-warning mb-4" role="alert">
            @Model.StatusMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
        <div>
            <div class="small text-uppercase text-muted fw-semibold">Historial de compras</div>
            <h1 class="h3 fw-bold mt-2 mb-1">Mis pedidos</h1>
            <p class="text-muted mb-0">Consulta el estado, la fecha y el resumen económico de tus pedidos registrados.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-page="/Account/Index" class="btn btn-outline-secondary">Volver a Mi cuenta</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div asp-validation-summary="ModelOnly" class="text-danger small col-12"></div>

                <div class="col-md-4 col-lg-3">
                    <label asp-for="Status" class="form-label">Filtrar por estado</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">Todos</option>
                        @foreach (EstadoPedido status in Enum.GetValues<EstadoPedido>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label asp-for="Condition" class="form-label">Condición operativa</label>
                    <select asp-for="Condition" class="form-select">
                        <option value="">Todas</option>
                        <option value="@IndexModel.OrderConditionFilter.Active">Activos</option>
                        <option value="@IndexModel.OrderConditionFilter.Finalized">Finalizados</option>
                    </select>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label asp-for="CreatedFrom" class="form-label">Desde</label>
                    <input asp-for="CreatedFrom" class="form-control" type="date" />
                    <span asp-validation-for="CreatedFrom" class="text-danger small"></span>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label asp-for="CreatedTo" class="form-label">Hasta</label>
                    <input asp-for="CreatedTo" class="form-control" type="date" />
                    <span asp-validation-for="CreatedTo" class="text-danger small"></span>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label asp-for="MinTotalAmount" class="form-label">Monto mínimo</label>
                    <input asp-for="MinTotalAmount" class="form-control" type="number" min="0" step="0.01" />
                    <span asp-validation-for="MinTotalAmount" class="text-danger small"></span>
                </div>

                <div class="col-md-4 col-lg-3">
                    <label asp-for="MaxTotalAmount" class="form-label">Monto máximo</label>
                    <input asp-for="MaxTotalAmount" class="form-control" type="number" min="0" step="0.01" />
                    <span asp-validation-for="MaxTotalAmount" class="text-danger small"></span>
                </div>

                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">Aplicar filtro</button>
                </div>
                <div class="col-md-auto">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>

            @if (Model.HasActiveFilters)
            {
                <div class="small text-muted mt-3">
                    Los filtros actuales permanecen en la URL para que puedas compartir o retomar esta vista sin perder el contexto.
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Orders.Count == 0)
            {
                <div class="p-4 p-lg-5 text-center">
                    <div class="fw-semibold mb-2">Todavía no tienes pedidos registrados.</div>
                    <div class="text-muted">Cuando completes compras en la plataforma, aquí verás el historial consolidado de tu cuenta.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Pedido</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Contenido</th>
                                <th>Total</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@order.Id</div>
                                    <div class="text-muted small">@(order.IsFinalized ? "Pedido finalizado" : "Pedido activo")</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(order.IsFinalized ? "text-bg-secondary" : "text-bg-primary")">@order.StatusLabel</span>
                                </td>
                                <td>@order.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")</td>
                                <td>@order.ItemsCount línea(s) · @order.TotalUnits unidad(es)</td>
                                <td class="fw-semibold">@order.Currency @order.TotalAmount.ToString("N2")</td>
                                <td class="text-end">
                                     <a asp-page="./Details" asp-route-id="@order.Id" asp-all-route-data="Model.CurrentFilterRouteValues" class="btn btn-sm btn-outline-dark">Ver detalle</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
            }
        </div>
    </div>
</div>
