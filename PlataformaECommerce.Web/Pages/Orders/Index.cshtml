@page
@using PlataformaECommerce.Domain.Enums
@model PlataformaECommerce.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Mis pedidos";
}

<div class="container py-5">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-warning mb-4" role="alert">
            @Model.StatusMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
        <div>
            <div class="small text-uppercase text-muted fw-semibold">Historial de compras</div>
            <h1 class="h3 fw-bold mt-2 mb-1">Mis pedidos</h1>
            <p class="text-muted mb-0">Consulta el estado, la fecha y el resumen económico de tus pedidos registrados.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-page="/Account/Index" class="btn btn-outline-secondary">Volver a Mi cuenta</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4 col-lg-3">
                    <label asp-for="Status" class="form-label">Filtrar por estado</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">Todos</option>
                        @foreach (EstadoPedido status in Enum.GetValues<EstadoPedido>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">Aplicar filtro</button>
                </div>
                <div class="col-md-auto">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Orders.Count == 0)
            {
                <div class="p-4 p-lg-5 text-center">
                    <div class="fw-semibold mb-2">Todavía no tienes pedidos registrados.</div>
                    <div class="text-muted">Cuando completes compras en la plataforma, aquí verás el historial consolidado de tu cuenta.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Pedido</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Contenido</th>
                                <th>Total</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@order.Id</div>
                                    <div class="text-muted small">@(order.IsFinalized ? "Pedido finalizado" : "Pedido activo")</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(order.IsFinalized ? "text-bg-secondary" : "text-bg-primary")">@order.StatusLabel</span>
                                </td>
                                <td>@order.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")</td>
                                <td>@order.ItemsCount línea(s) · @order.TotalUnits unidad(es)</td>
                                <td class="fw-semibold">@order.Currency @order.TotalAmount.ToString("N2")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                        @if (order.CanStartOnlinePayment)
                                        {
                                            <a asp-page="/Payments/Start" asp-route-orderId="@order.Id" class="btn btn-sm btn-primary">Pagar</a>
                                        }
                                        <a asp-page="./Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">Ver detalle</a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
