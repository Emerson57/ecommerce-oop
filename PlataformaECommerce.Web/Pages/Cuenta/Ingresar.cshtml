@page
@model PlataformaECommerce.Web.Pages.Cuenta.IngresarModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="auth-page">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-highlight">
                <span class="auth-eyebrow">Mi cuenta</span>
                <h1>Bienvenido de nuevo</h1>
                <p>
                    Inicia sesión para consultar tus pedidos, guardar favoritos, administrar tu perfil
                    y continuar con una experiencia de compra rápida y personalizada.
                </p>

                <div class="auth-benefits">
                    <div class="auth-benefit-item">
                        <strong>Compras más rápidas</strong>
                        <span>Guarda tus datos para finalizar pedidos con mayor agilidad.</span>
                    </div>
                    <div class="auth-benefit-item">
                        <strong>Seguimiento de pedidos</strong>
                        <span>Consulta el estado de tus compras desde un solo lugar.</span>
                    </div>
                    <div class="auth-benefit-item">
                        <strong>Favoritos y recomendaciones</strong>
                        <span>Accede a productos guardados y sugerencias personalizadas.</span>
                    </div>
                </div>
            </div>

            <div class="auth-card">
                <div class="auth-card-header">
                    <h2>Iniciar sesión</h2>
                    <p>Accede con tu correo y contraseña.</p>
                </div>

                <form class="auth-form" novalidate>
                    <div class="form-field">
                        <label for="correo">Correo electrónico</label>
                        <input id="correo" type="email" placeholder="correo@dominio.com" />
                    </div>

                    <div class="form-field">
                        <div class="field-row-between">
                            <label for="contrasena">Contraseña</label>
                            <a href="#" class="field-link">¿Olvidaste tu contraseña?</a>
                        </div>
                        <input id="contrasena" type="password" placeholder="Ingresa tu contraseña" />
                    </div>

                    <div class="field-inline">
                        <label class="checkbox-inline">
                            <input type="checkbox" />
                            <span>Recordar mi sesión</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-block-primary">Entrar a mi cuenta</button>

                    <div class="auth-divider">
                        <span>o</span>
                    </div>

                    <button type="button" class="btn-block-secondary">Continuar con Google</button>

                    <p class="auth-footer-text">
                        ¿Todavía no tienes cuenta?
                        <a asp-page="/Cuenta/Registro">Crear cuenta</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>