@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-commerce">
    <div class="container">
        <div class="hero-commerce-grid">
            <div class="hero-main-banner">
                <span class="hero-badge">Temporada de ofertas</span>
                <h1>Descubre productos que elevan tu estilo y tu día a día</h1>
                <p>
                    Compra tecnología, hogar, moda y mucho más en una experiencia moderna,
                    rápida y pensada para ofrecer confianza desde el primer clic.
                </p>

                <div class="hero-buttons">
                    <a asp-page="/Catalog/Index" class="btn-shop-primary">Comprar ahora</a>
                    <a asp-page="/Catalog/Index" class="btn-shop-secondary">Ver catálogo</a>
                </div>
            </div>

            <div class="hero-side-offers">
                <article class="side-offer-card">
                    <span>Promoción exclusiva</span>
                    <h3>Hasta 40% OFF</h3>
                    <p>En productos seleccionados de tecnología y accesorios.</p>
                     <a asp-page="/Catalog/Index">Ver oferta</a>
                </article>

                <article class="side-offer-card">
                    <span>Nueva colección</span>
                    <h3>Hogar & confort</h3>
                    <p>Renueva tus espacios con diseño, funcionalidad y estilo.</p>
                     <a asp-page="/Catalog/Index">Explorar</a>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="categories-section">
    <div class="container">
        <div class="section-title-center">
            <span>Categorías destacadas</span>
            <h2>Encuentra lo que necesitas más rápido</h2>
            <p>Una navegación clara mejora la experiencia de compra y hace que el catálogo se vea más profesional.</p>
        </div>

        @if (Model.FeaturedCategories.Count == 0)
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center text-muted">
                    Aún no hay categorías activas destacadas para mostrar en el storefront.
                </div>
            </div>
        }
        else
        {
            <div class="categories-grid">
                @foreach (var category in Model.FeaturedCategories)
                {
                    <a asp-page="/Catalog/Index" asp-route-categoryId="@category.Id" class="category-card">
                        <div class="category-image @category.AccentCssClass"></div>
                        <h3>@category.Name</h3>
                        <p>@category.Description</p>
                    </a>
                }
            </div>
        }
    </div>
</section>

<section class="products-section">
    <div class="container">
        <div class="section-title-between">
            <div>
                <span>Productos destacados</span>
                <h2>Selección recomendada para ti</h2>
            </div>
            <a asp-page="/Catalog/Index" class="view-all-link">Ver todo</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-4" role="alert">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.FeaturedProducts.Count == 0)
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5 text-center">
                    <h3 class="h5 fw-bold mb-2">Aún no hay productos visibles en portada</h3>
                    <p class="text-muted mb-0">Cuando existan productos activos con stock, esta sección se alimentará automáticamente desde el catálogo real.</p>
                </div>
            </div>
        }
        else
        {
            <div class="products-grid">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <article class="product-card">
                        <a asp-page="/Catalog/Details" asp-route-id="@product.Id" class="text-decoration-none d-block">
                            <img src="@product.MainImageUrl" alt="Imagen principal de @product.Name" class="product-image product-image-cover" loading="lazy" />
                        </a>
                        <span class="product-tag">@product.BadgeText</span>
                        <h3>@product.Name</h3>
                        <p class="product-category">@product.CategoryName</p>
                        <div class="product-price-row">
                            <strong>@product.Currency @product.Price.ToString("N2")</strong>
                            @if (product.PreviousPrice.HasValue && product.PreviousPrice.Value > product.Price)
                            {
                                <span>@product.Currency @product.PreviousPrice.Value.ToString("N2")</span>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-page="/Catalog/Details" asp-route-id="@product.Id" class="product-btn text-decoration-none text-center d-inline-block">Ver detalle</a>
                            @if (Model.CanPurchaseAsCustomer)
                            {
                                <form method="post" asp-page="/Cart/Index" asp-page-handler="AddItem" class="d-grid">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@Url.Page("/Index")" />
                                    <button type="submit" class="btn btn-outline-secondary">Agregar al carrito</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="promo-banner-section">
    <div class="container">
        <div class="promo-banner">
            <div>
                <span class="promo-mini">Beneficio especial</span>
                <h2>Compra con envío rápido y promociones semanales</h2>
                <p>
                    Diseñamos una experiencia enfocada en confianza, rapidez y facilidad de compra,
                    como debe verse una tienda profesional real.
                </p>
            </div>
            <a asp-page="/Catalog/Index" class="btn-shop-primary">Descubrir ofertas</a>
        </div>
    </div>
</section>

<section class="benefits-section">
    <div class="container">
        <div class="benefits-grid">
            <article class="benefit-card">
                <h3>Envíos rápidos</h3>
                <p>Entregas ágiles para mejorar la experiencia del cliente.</p>
            </article>

            <article class="benefit-card">
                <h3>Pagos seguros</h3>
                <p>Proceso de compra confiable con enfoque en seguridad.</p>
            </article>

            <article class="benefit-card">
                <h3>Atención personalizada</h3>
                <p>Soporte claro y cercano para acompañar cada compra.</p>
            </article>

            <article class="benefit-card">
                <h3>Devoluciones sencillas</h3>
                <p>Políticas claras que transmiten tranquilidad al usuario.</p>
            </article>
        </div>
    </div>
</section>