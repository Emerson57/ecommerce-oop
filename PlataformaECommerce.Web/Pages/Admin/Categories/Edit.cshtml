@page "{id:guid}"
@model PlataformaECommerce.Web.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "Editar categoría";
    ViewData["Subtitle"] = "Mantenimiento administrativo de taxonomía";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="card admin-summary-card border-0">
    <div class="card-body p-4 p-lg-5">
        <form method="post" novalidate>
            <input asp-for="Input.Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="admin-muted-label">@(Model.IsRootCategory ? "Categoría principal" : "Subcategoría")</div>
                    <h2 class="h4 fw-bold mt-2 mb-2">@Model.Input.Name</h2>
                    <p class="text-muted mb-0">Actualice la estructura, visibilidad y datos funcionales de la categoría seleccionada.</p>
                </div>
                <div class="col-lg-4">
                    <div class="rounded-4 border bg-light p-4 h-100">
                        <div class="small text-muted">Estado actual</div>
                        <div class="fw-semibold mt-2">@(Model.Input.IsActive ? "Activa" : "Inactiva")</div>
                        <div class="small text-muted mt-2">
                            @(Model.IsRootCategory
                                ? "Esta categoría puede recibir subcategorías hijas dentro del MVP."
                                : $"Depende de la categoría principal {(string.IsNullOrWhiteSpace(Model.ParentCategoryName) ? "seleccionada" : Model.ParentCategoryName)}.")
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.CanCreateSubcategory)
            {
                <div class="alert alert-info d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3" role="alert">
                    <div>
                        <div class="fw-semibold">Categoría principal lista para extender la taxonomía</div>
                        <div class="small">Puede registrar una subcategoría hija manteniendo esta categoría como padre.</div>
                    </div>
                    <a asp-page="./Create" asp-route-parentCategoryId="@Model.Input.Id" class="btn btn-outline-primary btn-sm">Crear subcategoría hija</a>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label">Nombre</label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Slug" class="form-label">Slug</label>
                    <input asp-for="Input.Slug" class="form-control" />
                    <span asp-validation-for="Input.Slug" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label">Descripción</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ParentCategoryId" class="form-label">Categoría principal</label>
                    <select asp-for="Input.ParentCategoryId" class="form-select">
                        <option value="">Sin padre · Categoría principal</option>
                        @foreach (var category in Model.ParentCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <div class="form-text">Una subcategoría solo puede depender de una categoría principal activa dentro del catálogo administrativo.</div>
                </div>
                <div class="col-md-6 form-check mt-md-5 pt-md-2 ms-md-2">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label">Mantener activa</label>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-5">
                <button type="submit" class="btn btn-primary">Guardar @(Model.IsRootCategory ? "categoría" : "subcategoría")</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
