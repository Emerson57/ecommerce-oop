@page
@model PlataformaECommerce.Web.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Categorías";
    ViewData["Subtitle"] = "Gobierno administrativo de la taxonomía del catálogo";
}

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success mb-4" role="alert">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.StatusErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        @Model.StatusErrorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="card admin-summary-card border-0 mb-4">
    <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
        <div>
            <div class="admin-muted-label">Taxonomía del catálogo</div>
            <h2 class="h4 fw-bold mt-2 mb-2">Categorías y subcategorías</h2>
            <p class="text-muted mb-0">Administre la estructura principal del catálogo y sus nodos hijos válidos para clasificación de productos.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="./Create" class="btn btn-primary">Nueva categoría principal</a>
            <a asp-page="./Create" class="btn btn-outline-primary">Nueva subcategoría</a>
            <a asp-page="/Admin/Products/Index" class="btn btn-outline-secondary">Volver a productos</a>
        </div>
    </div>
</div>

<div class="card admin-summary-card border-0 mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-start">
            <div class="col-lg-6">
                <div class="admin-muted-label">Importación masiva</div>
                <h2 class="h4 fw-bold mt-2 mb-2">Carga XML, CSV o Excel de categorías y subcategorías</h2>
                <p class="text-muted mb-3">Descargue la plantilla oficial en <strong>XML</strong>, <strong>CSV</strong> o <strong>Excel (.xlsx)</strong>, diligénciela usando los campos <strong>Name</strong>, <strong>Slug</strong>, <strong>Description</strong>, <strong>IsActive</strong> y <strong>ParentCategoryName</strong>, y luego súbala desde este mismo panel para registrar la taxonomía en la base de datos.</p>
                <ul class="admin-rule-list">
                    <li>Use únicamente una de las plantillas descargables desde esta pantalla.</li>
                    <li>Deje <code>ParentCategoryName</code> vacío cuando la fila represente una categoría principal.</li>
                    <li>Para una subcategoría, informe en <code>ParentCategoryName</code> el nombre exacto de la categoría principal existente o incluida en el mismo archivo.</li>
                    <li>Cada slug debe ser único dentro del archivo y también frente a categorías ya existentes.</li>
                    <li>La importación es atómica: si un nodo falla, no se guarda ningún registro parcial.</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="rounded-4 border bg-light-subtle p-4 h-100">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a asp-page-handler="DownloadTemplate" class="btn btn-outline-primary">Descargar XML</a>
                        <a asp-page-handler="DownloadCsvTemplate" class="btn btn-outline-primary">Descargar CSV</a>
                        <a asp-page-handler="DownloadExcelTemplate" class="btn btn-outline-primary">Descargar Excel</a>
                    </div>

                    <form method="post" asp-page-handler="Import" enctype="multipart/form-data" novalidate>
                        <div class="mb-3">
                            <label asp-for="ImportInput.ImportFile" class="form-label"></label>
                            <input asp-for="ImportInput.ImportFile" type="file" class="form-control" accept=".xml,.csv,.xlsx,text/xml,application/xml,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                            <div class="form-text">Formatos soportados: XML, CSV y Excel (.xlsx). Tamaño máximo permitido: 1 MB.</div>
                            <span asp-validation-for="ImportInput.ImportFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Importar categorías</button>
                            <a asp-page="./Create" class="btn btn-outline-secondary">Crear manualmente</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card admin-summary-card border-0">
    <div class="card-body p-0">
        @if (Model.Categories.Count == 0)
        {
            <div class="p-4 text-muted">No hay categorías registradas todavía.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Categoría</th>
                            <th>Slug</th>
                            <th>Jerarquía</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@category.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <div class="small text-muted">@category.Description</div>
                                    }
                                </td>
                                <td><code>@category.Slug</code></td>
                                <td>
                                    <div class="small fw-semibold">@(category.IsRootCategory ? "Categoría principal" : "Subcategoría")</div>
                                    <div class="small text-muted">@Model.GetParentName(category)</div>
                                </td>
                                <td>
                                    <span class="badge @(category.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(category.IsActive ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                                        <a asp-page="./Edit" asp-route-id="@category.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                                        @if (category.IsRootCategory)
                                        {
                                            <a asp-page="./Create" asp-route-parentCategoryId="@category.Id" class="btn btn-outline-dark btn-sm">Crear subcategoría</a>
                                        }
                                        <form method="post" asp-page-handler="@(category.IsActive ? "Deactivate" : "Activate")" class="d-inline">
                                            <input type="hidden" name="categoryId" value="@category.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                @(category.IsActive ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
