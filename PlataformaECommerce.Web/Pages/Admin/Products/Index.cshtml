@page
@using PlataformaECommerce.Application.Features.Products.Commands
@using PlataformaECommerce.Domain.Enums
@model PlataformaECommerce.Web.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
    ViewData["Subtitle"] = "Catálogo administrativo del backoffice";
}

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success mb-4" role="alert">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.StatusErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        @Model.StatusErrorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="card admin-summary-card border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-end mb-3">
            <a asp-page="./Create" class="btn btn-primary btn-sm">Nuevo producto</a>
        </div>

        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6 col-xl-3">
                <label asp-for="SearchTerm" class="form-label">Búsqueda</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="Nombre, SKU o descripción" />
            </div>

            <div class="col-md-6 col-xl-2">
                <label asp-for="ProductType" class="form-label">Tipo</label>
                <select asp-for="ProductType" class="form-select">
                    <option value="">Todos</option>
                    <option value="@TipoProducto.Fisico">Físico</option>
                    <option value="@TipoProducto.Digital">Digital</option>
                </select>
            </div>

            <div class="col-md-6 col-xl-2">
                <label asp-for="IsActive" class="form-label">Estado</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="">Todos</option>
                    <option value="true">Activos</option>
                    <option value="false">Inactivos</option>
                </select>
            </div>

            <div class="col-md-6 col-xl-2">
                <label asp-for="IsFeatured" class="form-label">Destacado</label>
                <select asp-for="IsFeatured" class="form-select">
                    <option value="">Todos</option>
                    <option value="true">Destacados</option>
                    <option value="false">No destacados</option>
                </select>
            </div>

            <div class="col-md-6 col-xl-1">
                <label asp-for="HasStock" class="form-label">Stock</label>
                <select asp-for="HasStock" class="form-select">
                    <option value="">Todos</option>
                    <option value="true">Con stock</option>
                    <option value="false">Sin stock</option>
                </select>
            </div>

            <div class="col-md-6 col-xl-2">
                <label asp-for="SortBy" class="form-label">Orden</label>
                <select asp-for="SortBy" class="form-select">
                    <option value="createdAt">Creación</option>
                    <option value="updatedAt">Actualización</option>
                    <option value="name">Nombre</option>
                    <option value="price">Precio</option>
                    <option value="stock">Stock</option>
                </select>
            </div>

            <div class="col-md-6 col-xl-2">
                <label asp-for="PageSize" class="form-label">Tamaño</label>
                <select asp-for="PageSize" class="form-select">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>

            <div class="col-md-6 col-xl-2 form-check mt-xl-4 pt-xl-2 ms-xl-2">
                <input asp-for="SortDescending" class="form-check-input" />
                <label asp-for="SortDescending" class="form-check-label">Descendente</label>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Aplicar filtros</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card admin-summary-card border-0 mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-start">
            <div class="col-lg-7">
                <div class="admin-muted-label">Importación masiva</div>
                <h2 class="h4 fw-bold mt-2 mb-2">Carga Excel profesional de productos</h2>
                <p class="text-muted mb-3">Descargue la plantilla oficial en Excel, complete la información comercial y técnica del producto y luego cargue el archivo desde este mismo panel para registrar productos físicos y digitales en el catálogo.</p>
                <ul class="admin-rule-list mb-0">
                    <li>La plantilla usa listas desplegables para <code>TipoProducto</code>, <code>Categoria</code> y <code>Subcategoria</code>.</li>
                    <li>Las categorías y subcategorías se cargan desde la base de datos y se resuelven internamente a sus identificadores reales.</li>
                    <li>Los productos físicos deben informar <code>PesoKg</code>, <code>AltoCm</code>, <code>AnchoCm</code>, <code>LargoCm</code> y <code>RequiereEnvio</code>.</li>
                    <li>Los productos digitales deben informar <code>FormatoArchivo</code>, <code>TamanoMB</code> y <code>RequiereLicencia</code>.</li>
                    <li>La columna <code>EtiquetasSerializadas</code> admite valores separados por coma, punto y coma o barra vertical.</li>
                    <li>La importación es atómica: si una fila falla, no se persisten productos parciales.</li>
                </ul>
            </div>
            <div class="col-lg-5">
                <div class="rounded-4 border bg-light-subtle p-4 h-100">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a asp-page-handler="DownloadImportTemplate" class="btn btn-outline-primary">Descargar plantilla Excel</a>
                    </div>

                    <form method="post" asp-page-handler="Import" enctype="multipart/form-data" novalidate>
                        <div class="mb-3">
                            <label asp-for="ImportInput.ImportFile" class="form-label">Archivo Excel</label>
                            <input asp-for="ImportInput.ImportFile" type="file" class="form-control" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                            <div class="form-text">Formato soportado: Excel (.xlsx). Tamaño máximo permitido: 2 MB.</div>
                            <span asp-validation-for="ImportInput.ImportFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Importar productos</button>
                            <a asp-page="./Create" class="btn btn-outline-secondary">Crear manualmente</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card admin-summary-card border-0">
    <div class="card-body p-0">
        @if (Model.Products.Count == 0)
        {
            <div class="p-4 text-muted">
                No se encontraron productos con los filtros seleccionados.
            </div>
        }
        else
        {
            <div class="p-3 border-bottom bg-body-tertiary d-flex flex-column flex-lg-row justify-content-between gap-2 small text-muted">
                <span>Mostrando <strong>@Model.FirstItemNumber</strong> a <strong>@Model.LastItemNumber</strong> de <strong>@Model.TotalCount</strong> productos</span>
                <span>Página <strong>@Model.PageNumber</strong> de <strong>@Model.TotalPages</strong></span>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Tipo</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th>Destacado</th>
                            <th>Actualización</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex gap-3 align-items-start">
                                        <img src="@(string.IsNullOrWhiteSpace(product.MainImageUrl) ? "/images/placeholders/product-placeholder.svg" : product.MainImageUrl)" alt="Imagen principal de @product.Name" class="admin-product-thumbnail" loading="lazy" />
                                        <div>
                                            <div class="fw-semibold">@product.Name</div>
                                            <div class="small text-muted">SKU: @product.Sku</div>
                                            <div class="small text-muted">Slug: @product.Slug</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(product.ProductType == TipoProducto.Fisico ? "text-bg-secondary" : "text-bg-info")">
                                        @product.ProductType
                                    </span>
                                </td>
                                <td>
                                    @if (product.HasPromotion)
                                    {
                                        <div class="fw-semibold text-success">@product.Currency @product.Price.ToString("N2")</div>
                                        <div class="small text-muted text-decoration-line-through">@product.Currency @product.BasePrice.ToString("N2")</div>
                                        <div class="small text-success">Descuento activo: @product.CurrentDiscountPercentage?.ToString("N2")%</div>
                                    }
                                    else
                                    {
                                        <div class="fw-semibold text-nowrap">@product.Currency @product.Price.ToString("N2")</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@product.Stock</div>
                                    <div class="small text-muted">@(product.HasStock ? "Disponible" : "Sin inventario")</div>
                                </td>
                                <td>
                                    <span class="badge @(product.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(product.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(product.IsFeatured ? "text-bg-warning" : "text-bg-light")">
                                        @(product.IsFeatured ? "Destacado" : "Estándar")
                                    </span>
                                </td>
                                <td class="small text-muted text-nowrap">
                                    @(product.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? product.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm"))
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-2 align-items-end">
                                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                                            <a asp-page="./Edit" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Editar</a>

                                            <form method="post" asp-page-handler="@(product.IsActive ? "Deactivate" : "Activate")" class="d-inline">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="ProductType" value="@Model.ProductType" />
                                                <input type="hidden" name="IsActive" value="@Model.IsActive" />
                                                <input type="hidden" name="IsFeatured" value="@Model.IsFeatured" />
                                                <input type="hidden" name="HasStock" value="@Model.HasStock" />
                                                <input type="hidden" name="SortBy" value="@Model.SortBy" />
                                                <input type="hidden" name="SortDescending" value="@Model.SortDescending" />
                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                    @(product.IsActive ? "Desactivar" : "Activar")
                                                </button>
                                            </form>

                                            <form method="post" asp-page-handler="@(product.IsFeatured ? "Unfeature" : "Feature")" class="d-inline">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="ProductType" value="@Model.ProductType" />
                                                <input type="hidden" name="IsActive" value="@Model.IsActive" />
                                                <input type="hidden" name="IsFeatured" value="@Model.IsFeatured" />
                                                <input type="hidden" name="HasStock" value="@Model.HasStock" />
                                                <input type="hidden" name="SortBy" value="@Model.SortBy" />
                                                <input type="hidden" name="SortDescending" value="@Model.SortDescending" />
                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                                <button type="submit" class="btn btn-outline-dark btn-sm">
                                                    @(product.IsFeatured ? "Quitar destacado" : "Destacar")
                                                </button>
                                            </form>
                                        </div>

                                        <details class="w-100">
                                            <summary class="small text-primary text-end">Ajustar stock</summary>
                                            <form method="post" asp-page-handler="UpdateStock" class="mt-2 border rounded-3 p-3 bg-light-subtle">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="ProductType" value="@Model.ProductType" />
                                                <input type="hidden" name="IsActive" value="@Model.IsActive" />
                                                <input type="hidden" name="IsFeatured" value="@Model.IsFeatured" />
                                                <input type="hidden" name="HasStock" value="@Model.HasStock" />
                                                <input type="hidden" name="SortBy" value="@Model.SortBy" />
                                                <input type="hidden" name="SortDescending" value="@Model.SortDescending" />
                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />

                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <label class="form-label small">Operación</label>
                                                        <select name="updateType" class="form-select form-select-sm">
                                                            <option value="@StockUpdateType.Set">Fijar</option>
                                                            <option value="@StockUpdateType.Increase">Incrementar</option>
                                                            <option value="@StockUpdateType.Decrease">Disminuir</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label small">Cantidad</label>
                                                        <input name="quantity" type="number" min="1" value="1" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="form-label small">Motivo</label>
                                                        <input name="reason" class="form-control form-control-sm" placeholder="Ajuste manual" />
                                                    </div>
                                                    <div class="col-12 d-flex justify-content-end">
                                                        <button type="submit" class="btn btn-outline-success btn-sm">Aplicar stock</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </details>

                                        <details class="w-100">
                                            <summary class="small text-primary text-end">Aplicar promoción</summary>
                                            <form method="post" asp-page-handler="ApplyPromotion" class="mt-2 border rounded-3 p-3 bg-light-subtle">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="ProductType" value="@Model.ProductType" />
                                                <input type="hidden" name="IsActive" value="@Model.IsActive" />
                                                <input type="hidden" name="IsFeatured" value="@Model.IsFeatured" />
                                                <input type="hidden" name="HasStock" value="@Model.HasStock" />
                                                <input type="hidden" name="SortBy" value="@Model.SortBy" />
                                                <input type="hidden" name="SortDescending" value="@Model.SortDescending" />
                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />

                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <label class="form-label small">Descuento (%)</label>
                                                        <input name="discountPercentage" type="number" min="0.01" max="90" step="0.01" class="form-control form-control-sm" placeholder="10" />
                                                    </div>
                                                    <div class="col-md-8">
                                                        <label class="form-label small">Motivo</label>
                                                        <input name="reason" class="form-control form-control-sm" placeholder="Campaña comercial" />
                                                    </div>
                                                    <div class="col-12 d-flex justify-content-end">
                                                        <button type="submit" class="btn btn-outline-warning btn-sm">Aplicar promoción</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </details>

                                        @if (product.HasPromotion)
                                        {
                                            <form method="post" asp-page-handler="RemovePromotion" class="w-100 border rounded-3 p-3 bg-light-subtle">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                                <input type="hidden" name="ProductType" value="@Model.ProductType" />
                                                <input type="hidden" name="IsActive" value="@Model.IsActive" />
                                                <input type="hidden" name="IsFeatured" value="@Model.IsFeatured" />
                                                <input type="hidden" name="HasStock" value="@Model.HasStock" />
                                                <input type="hidden" name="SortBy" value="@Model.SortBy" />
                                                <input type="hidden" name="SortDescending" value="@Model.SortDescending" />
                                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="PageSize" value="@Model.PageSize" />

                                                <div class="small text-muted mb-2">
                                                    Precio base: <strong>@product.Currency @product.BasePrice.ToString("N2")</strong>
                                                    · Promocional: <strong>@product.Currency @product.Price.ToString("N2")</strong>
                                                </div>
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-8">
                                                        <label class="form-label small">Motivo</label>
                                                        <input name="reason" class="form-control form-control-sm" placeholder="Fin de campaña" />
                                                    </div>
                                                    <div class="col-md-4 d-flex justify-content-end">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">Restaurar precio base</button>
                                                    </div>
                                                </div>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="p-3 border-top">
                    <nav aria-label="Paginación del catálogo administrativo">
                        <ul class="pagination pagination-sm flex-wrap mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-ProductType="@Model.ProductType"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-IsFeatured="@Model.IsFeatured"
                                   asp-route-HasStock="@Model.HasStock"
                                   asp-route-SortBy="@Model.SortBy"
                                   asp-route-SortDescending="@Model.SortDescending"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-PageNumber="1">Primera</a>
                            </li>
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-ProductType="@Model.ProductType"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-IsFeatured="@Model.IsFeatured"
                                   asp-route-HasStock="@Model.HasStock"
                                   asp-route-SortBy="@Model.SortBy"
                                   asp-route-SortDescending="@Model.SortDescending"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-PageNumber="@(Math.Max(1, Model.PageNumber - 1))">Anterior</a>
                            </li>

                            @foreach (int pageNumber in Model.VisiblePageNumbers)
                            {
                                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-ProductType="@Model.ProductType"
                                       asp-route-IsActive="@Model.IsActive"
                                       asp-route-IsFeatured="@Model.IsFeatured"
                                       asp-route-HasStock="@Model.HasStock"
                                       asp-route-SortBy="@Model.SortBy"
                                       asp-route-SortDescending="@Model.SortDescending"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-PageNumber="@pageNumber">@pageNumber</a>
                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-ProductType="@Model.ProductType"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-IsFeatured="@Model.IsFeatured"
                                   asp-route-HasStock="@Model.HasStock"
                                   asp-route-SortBy="@Model.SortBy"
                                   asp-route-SortDescending="@Model.SortDescending"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-PageNumber="@(Math.Min(Model.TotalPages, Model.PageNumber + 1))">Siguiente</a>
                            </li>
                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-ProductType="@Model.ProductType"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-IsFeatured="@Model.IsFeatured"
                                   asp-route-HasStock="@Model.HasStock"
                                   asp-route-SortBy="@Model.SortBy"
                                   asp-route-SortDescending="@Model.SortDescending"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-PageNumber="@Model.TotalPages">Última</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
