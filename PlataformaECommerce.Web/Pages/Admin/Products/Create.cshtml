@page
@using PlataformaECommerce.Domain.Enums
@using PlataformaECommerce.Web.Services.Products
@model PlataformaECommerce.Web.Pages.Admin.Products.CreateModel
@{
    ViewData["Title"] = "Crear producto";
    ViewData["Subtitle"] = "Alta administrativa de catálogo";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="card admin-summary-card border-0">
    <div class="card-body p-4 p-lg-5">
        <form method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="admin-muted-label">Nuevo producto</div>
                    <h2 class="h4 fw-bold mt-2 mb-2">Registro unificado de catálogo</h2>
                    <p class="text-muted mb-0">
                        Complete la información común del producto, seleccione si será físico o digital
                        y capture únicamente los datos específicos que correspondan al tipo elegido.
                    </p>
                </div>
                <div class="col-lg-4">
                    <div class="rounded-4 border bg-light p-4 h-100">
                        <div class="small text-muted">Tipo seleccionado</div>
                        <div class="fw-semibold mt-2">@Model.Input.ProductType</div>
                        <div class="small text-muted mt-2">El formulario ajusta los campos visibles según el tipo funcional.</div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.ProductType" class="form-label">Tipo de producto</label>
                    <select asp-for="Input.ProductType" class="form-select" id="productTypeSelector">
                        <option value="@TipoProducto.Fisico">Físico</option>
                        <option value="@TipoProducto.Digital">Digital</option>
                    </select>
                </div>
                <div class="col-md-4 form-check mt-md-5 pt-md-2 ms-md-2">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label">Crear como activo</label>
                </div>
                <div class="col-md-4 form-check mt-md-5 pt-md-2 ms-md-2">
                    <input asp-for="Input.IsFeatured" class="form-check-input" />
                    <label asp-for="Input.IsFeatured" class="form-check-label">Marcar como destacado</label>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label">Nombre</label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Sku" class="form-label">SKU</label>
                    <input asp-for="Input.Sku" class="form-control" />
                    <span asp-validation-for="Input.Sku" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label">Descripción</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Price" class="form-label">Precio</label>
                    <input asp-for="Input.Price" class="form-control" />
                    <span asp-validation-for="Input.Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Currency" class="form-label">Moneda</label>
                    <input asp-for="Input.Currency" class="form-control" />
                    <span asp-validation-for="Input.Currency" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Stock" class="form-label">Stock inicial</label>
                    <input asp-for="Input.Stock" class="form-control" />
                    <span asp-validation-for="Input.Stock" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Slug" class="form-label">Slug</label>
                    <input asp-for="Input.Slug" class="form-control" />
                    <span asp-validation-for="Input.Slug" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="row g-3 align-items-start">
                        <div class="col-lg-4">
                            <label class="form-label d-block">Previsualización</label>
                            <div class="admin-product-image-panel">
                                <img src="@Model.MainImagePreviewUrl" alt="Previsualización de la imagen principal del producto" class="admin-product-preview-image" id="mainImagePreview" />
                            </div>
                            <div class="form-text">Si no se carga una imagen, el catálogo mostrará un recurso visual de respaldo.</div>
                            <div class="form-text">El flujo separa la imagen principal del soporte previsto para una galería futura.</div>
                        </div>
                        <div class="col-lg-8">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Input.Images.MainImage.UploadedFile" class="form-label">Archivo de imagen principal</label>
                                    <input asp-for="Input.Images.MainImage.UploadedFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" id="mainImageFileInput" />
                                    <div class="form-text">Use esta opción para cargar la portada desde el backoffice. Si selecciona un archivo, la URL manual se limpiará automáticamente.</div>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.Images.MainImage.ExternalImageUrl" class="form-label">URL pública opcional</label>
                                    <div class="input-group">
                                        <input asp-for="Input.Images.MainImage.ExternalImageUrl" class="form-control" placeholder="https://... o /images/..." id="mainImageUrlInput" />
                                        <button type="button" class="btn btn-outline-secondary" id="mainImageUrlClearButton">Limpiar</button>
                                    </div>
                                    <div class="form-text">Use una sola fuente para la portada: archivo local o URL pública existente.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="rounded-4 border bg-light-subtle p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                            <div>
                                <div class="admin-muted-label">Galería inicial</div>
                                <h3 class="h5 fw-semibold mt-2 mb-1">URLs complementarias del producto</h3>
                                <p class="text-muted mb-0">El MVP admite solo URLs públicas o rutas relativas. La carga múltiple quedará para una iteración posterior.</p>
                            </div>
                            <div class="small text-muted">3 slots fijos</div>
                        </div>

                        <div class="row g-3">
                            @for (var index = 0; index < Model.Input.Images.Gallery.Count; index++)
                            {
                                var slot = Model.Input.Images.Gallery[index];
                                <div class="col-lg-4">
                                    <input asp-for="Input.Images.Gallery[index].Id" type="hidden" />
                                    <div class="border rounded-4 bg-white p-3 h-100">
                                        <label asp-for="Input.Images.Gallery[index].ImageUrl" class="form-label">Imagen de galería @(index + 1)</label>
                                        <div class="admin-product-image-panel mb-3">
                                            <img src="@ProductImageDefaults.ResolveDisplayUrl(slot.ResolvePreviewUrl())" alt="Previsualización de la imagen de galería @(index + 1)" class="admin-product-preview-image gallery-image-preview" id="galleryPreview_@index" />
                                        </div>
                                        <div class="input-group">
                                            <input asp-for="Input.Images.Gallery[index].ImageUrl" class="form-control gallery-image-url-input" placeholder="https://... o /images/..." data-preview-target="galleryPreview_@index" />
                                            <button type="button" class="btn btn-outline-secondary gallery-image-clear-button" data-input-target="Input_Images_Gallery_@(index)__ImageUrl">Limpiar</button>
                                        </div>
                                        <span asp-validation-for="Input.Images.Gallery[index].ImageUrl" class="text-danger small"></span>
                                        <div class="form-text">Use una ruta pública distinta de la imagen principal.</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <label asp-for="Input.CategoryId" class="form-label mb-0">Categoría principal</label>
                        <a asp-page="/Admin/Categories/Index" class="small text-decoration-none">Administrar categorías</a>
                    </div>
                    <select asp-for="Input.CategoryId" class="form-select" id="categorySelector">
                        <option value="">Seleccione una categoría</option>
                        @foreach (var category in Model.MainCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.SubcategoryId" class="form-label">Subcategoría</label>
                    <select asp-for="Input.SubcategoryId" class="form-select" id="subcategorySelector">
                        <option value="">Sin subcategoría</option>
                        @foreach (var subcategory in Model.Subcategories)
                        {
                            <option value="@subcategory.Id" data-parent-id="@subcategory.ParentCategoryId">@subcategory.Name</option>
                        }
                    </select>
                    <div class="form-text">Solo se muestran subcategorías válidas para la categoría principal seleccionada.</div>
                    <span asp-validation-for="Input.SubcategoryId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Tags" class="form-label">Etiquetas</label>
                    <input asp-for="Input.Tags" class="form-control" placeholder="hogar, tecnologia, premium" />
                </div>
            </div>

            <div id="physicalFields" class="mt-5 @(Model.Input.IsPhysicalProduct ? string.Empty : "d-none")">
                <div class="admin-muted-label">Producto físico</div>
                <h3 class="h5 fw-semibold mt-2 mb-3">Logística y dimensiones</h3>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="Input.WeightKg" class="form-label">Peso (kg)</label>
                        <input asp-for="Input.WeightKg" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.HeightCm" class="form-label">Alto (cm)</label>
                        <input asp-for="Input.HeightCm" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.WidthCm" class="form-label">Ancho (cm)</label>
                        <input asp-for="Input.WidthCm" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.LengthCm" class="form-label">Largo (cm)</label>
                        <input asp-for="Input.LengthCm" class="form-control" />
                    </div>
                    <div class="col-12 form-check mt-2 ms-2">
                        <input asp-for="Input.RequiresShipping" class="form-check-input" />
                        <label asp-for="Input.RequiresShipping" class="form-check-label">Requiere envío físico</label>
                    </div>
                </div>
            </div>

            <div id="digitalFields" class="mt-5 @(Model.Input.IsDigitalProduct ? string.Empty : "d-none")">
                <div class="admin-muted-label">Producto digital</div>
                <h3 class="h5 fw-semibold mt-2 mb-3">Entrega y licencia</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.FileFormat" class="form-label">Formato de archivo</label>
                        <input asp-for="Input.FileFormat" class="form-control" placeholder="PDF, MP4, ZIP..." />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.FileSizeMb" class="form-label">Tamaño (MB)</label>
                        <input asp-for="Input.FileSizeMb" class="form-control" />
                    </div>
                    <div class="col-12 form-check mt-2 ms-2">
                        <input asp-for="Input.RequiresLicense" class="form-check-input" />
                        <label asp-for="Input.RequiresLicense" class="form-check-label">Requiere licencia o activación</label>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-5">
                <button type="submit" class="btn btn-primary">Crear producto</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const selector = document.getElementById('productTypeSelector');
            const physicalFields = document.getElementById('physicalFields');
            const digitalFields = document.getElementById('digitalFields');
            const physicalOnlyFields = document.querySelectorAll('.physical-only');
            const categorySelector = document.getElementById('categorySelector');
            const subcategorySelector = document.getElementById('subcategorySelector');
            const mainImageFileInput = document.getElementById('mainImageFileInput');
            const mainImageUrlInput = document.getElementById('mainImageUrlInput');
            const mainImageUrlClearButton = document.getElementById('mainImageUrlClearButton');
            const mainImagePreview = document.getElementById('mainImagePreview');
            const galleryUrlInputs = document.querySelectorAll('.gallery-image-url-input');
            const galleryClearButtons = document.querySelectorAll('.gallery-image-clear-button');
            const defaultPreviewUrl = '@Model.MainImagePreviewUrl';
            const placeholderPreviewUrl = '/images/placeholders/product-placeholder.svg';

            function toggleSections() {
                if (!selector) {
                    return;
                }

                const isPhysical = selector.value === '@TipoProducto.Fisico';
                physicalFields?.classList.toggle('d-none', !isPhysical);
                digitalFields?.classList.toggle('d-none', isPhysical);
                physicalOnlyFields.forEach(field => field.classList.toggle('d-none', !isPhysical));
            }

            function syncSubcategories() {
                if (!categorySelector || !subcategorySelector) {
                    return;
                }

                const selectedCategoryId = categorySelector.value;
                const subcategoryOptions = Array.from(subcategorySelector.options);

                subcategoryOptions.forEach(option => {
                    if (!option.value) {
                        option.hidden = false;
                        option.disabled = false;
                        return;
                    }

                    const parentCategoryId = option.getAttribute('data-parent-id');
                    const isVisible = !!selectedCategoryId && parentCategoryId === selectedCategoryId;
                    option.hidden = !isVisible;
                    option.disabled = !isVisible;
                });

                const selectedOption = subcategorySelector.selectedOptions[0];
                if (selectedOption && selectedOption.value && selectedOption.disabled) {
                    subcategorySelector.value = '';
                }
            }

            function updateMainImagePreview() {
                if (!mainImagePreview) {
                    return;
                }

                const selectedFile = mainImageFileInput?.files?.[0];
                if (selectedFile) {
                    const objectUrl = URL.createObjectURL(selectedFile);
                    mainImagePreview.src = objectUrl;
                    return;
                }

                const externalUrl = mainImageUrlInput?.value?.trim();
                mainImagePreview.src = externalUrl || defaultPreviewUrl;
            }

            function updateGalleryPreview(input) {
                const previewTargetId = input?.dataset?.previewTarget;
                if (!previewTargetId) {
                    return;
                }

                const preview = document.getElementById(previewTargetId);
                if (!preview) {
                    return;
                }

                const imageUrl = input.value?.trim();
                preview.src = imageUrl || placeholderPreviewUrl;
            }

            function clearInputById(inputId) {
                const input = document.getElementById(inputId);
                if (!input) {
                    return;
                }

                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }

            selector?.addEventListener('change', toggleSections);
            categorySelector?.addEventListener('change', syncSubcategories);
            mainImageFileInput?.addEventListener('change', () => {
                if (mainImageFileInput.files?.length) {
                    clearInputById('mainImageUrlInput');
                }

                updateMainImagePreview();
            });
            mainImageUrlInput?.addEventListener('input', () => {
                if (mainImageUrlInput.value?.trim() && mainImageFileInput) {
                    mainImageFileInput.value = '';
                }

                updateMainImagePreview();
            });
            mainImageUrlClearButton?.addEventListener('click', () => clearInputById('mainImageUrlInput'));
            galleryUrlInputs.forEach(input => {
                input.addEventListener('input', () => updateGalleryPreview(input));
                updateGalleryPreview(input);
            });
            galleryClearButtons.forEach(button => {
                button.addEventListener('click', () => clearInputById(button.getAttribute('data-input-target')));
            });
            toggleSections();
            syncSubcategories();
            updateMainImagePreview();
        })();
    </script>
}
