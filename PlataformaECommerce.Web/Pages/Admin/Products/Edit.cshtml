@page "{id:guid}"
@using PlataformaECommerce.Domain.Enums
@using PlataformaECommerce.Web.Services.Products
@model PlataformaECommerce.Web.Pages.Admin.Products.EditModel
@{
    ViewData["Title"] = "Editar producto";
    ViewData["Subtitle"] = "Actualización administrativa del catálogo";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card admin-summary-card border-0">
            <div class="card-body p-4 p-lg-5">
                <form method="post" enctype="multipart/form-data" novalidate>
                    <input asp-for="Input.Id" type="hidden" />
                    <input asp-for="Input.ProductType" type="hidden" />
                    <input asp-for="Input.IsActive" type="hidden" />
                    <input asp-for="Input.IsFeatured" type="hidden" />
                    <input asp-for="Input.Images.MainImage.CurrentImageUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-4 mb-4">
                        <div class="col-lg-8">
                            <div class="admin-muted-label">Producto</div>
                            <h2 class="h4 fw-bold mt-2 mb-2">@Model.Input.Name</h2>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge @(Model.Input.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(Model.Input.IsActive ? "Activo" : "Inactivo")
                                </span>
                                <span class="badge @(Model.Input.IsFeatured ? "text-bg-warning" : "text-bg-light")">
                                    @(Model.Input.IsFeatured ? "Destacado" : "Estándar")
                                </span>
                                <span class="badge @(Model.Input.ProductType == TipoProducto.Fisico ? "text-bg-secondary" : "text-bg-info")">
                                    @Model.Input.ProductType
                                </span>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="rounded-4 border bg-light p-4 h-100">
                                <div class="small text-muted">Estado operativo</div>
                                <div class="fw-semibold mt-2">@(Model.Input.IsActive ? "Disponible para gestión comercial" : "Fuera de operación comercial")</div>
                                <div class="small text-muted mt-2">Las acciones de activación y destacado se mantienen desde el listado administrativo.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Name" class="form-label">Nombre</label>
                            <input asp-for="Input.Name" class="form-control" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Sku" class="form-label">SKU</label>
                            <input asp-for="Input.Sku" class="form-control" />
                            <span asp-validation-for="Input.Sku" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Description" class="form-label">Descripción</label>
                            <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Price" class="form-label">Precio base</label>
                            <input asp-for="Input.Price" class="form-control" />
                            <span asp-validation-for="Input.Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Currency" class="form-label">Moneda</label>
                            <input asp-for="Input.Currency" class="form-control" />
                            <span asp-validation-for="Input.Currency" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Stock" class="form-label">Stock</label>
                            <input asp-for="Input.Stock" class="form-control" />
                            <span asp-validation-for="Input.Stock" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Slug" class="form-label">Slug</label>
                            <input asp-for="Input.Slug" class="form-control" />
                            <span asp-validation-for="Input.Slug" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="row g-3 align-items-start">
                                <div class="col-lg-4">
                                    <label class="form-label d-block">Previsualización actual</label>
                                    <div class="admin-product-image-panel">
                                        <img src="@Model.MainImagePreviewUrl" alt="Previsualización de la imagen principal del producto" class="admin-product-preview-image" id="mainImagePreview" />
                                    </div>
                                    <div class="form-text">Origen actual: @Model.MainImageOriginLabel.</div>
                                </div>
                                <div class="col-lg-8">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label asp-for="Input.Images.MainImage.UploadedFile" class="form-label">Reemplazar imagen principal</label>
                                            <input asp-for="Input.Images.MainImage.UploadedFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" id="mainImageFileInput" />
                                            <div class="form-text">Use esta opción para reemplazar la portada desde el backoffice. Si selecciona un archivo, la URL manual se limpiará automáticamente.</div>
                                        </div>
                                        <div class="col-12">
                                            <label asp-for="Input.Images.MainImage.ExternalImageUrl" class="form-label">URL pública opcional</label>
                                            <div class="input-group">
                                                <input asp-for="Input.Images.MainImage.ExternalImageUrl" class="form-control" id="mainImageUrlInput" />
                                                <button type="button" class="btn btn-outline-secondary" id="mainImageUrlClearButton">Limpiar</button>
                                            </div>
                                            <div class="form-text">Use una sola fuente para la portada: archivo local o URL pública existente.</div>
                                        </div>
                                        <div class="col-12 form-check mt-2 ms-2">
                                            <input asp-for="Input.Images.MainImage.RemoveCurrentImage" class="form-check-input" id="removeCurrentImageInput" />
                                            <label asp-for="Input.Images.MainImage.RemoveCurrentImage" class="form-check-label">Eliminar la imagen actual si no se carga una nueva</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="rounded-4 border bg-light-subtle p-4">
                                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
                                    <div>
                                        <div class="admin-muted-label">Galería inicial</div>
                                        <h3 class="h5 fw-semibold mt-2 mb-1">URLs complementarias persistidas</h3>
                                        <p class="text-muted mb-0">Puede ajustar hasta 3 imágenes complementarias usando solo URLs públicas o rutas relativas.</p>
                                    </div>
                                    <div class="small text-muted">3 slots fijos</div>
                                </div>

                                <div class="row g-3">
                                    @for (var index = 0; index < Model.Input.Images.Gallery.Count; index++)
                                    {
                                        var slot = Model.Input.Images.Gallery[index];
                                        <div class="col-lg-4">
                                            <input asp-for="Input.Images.Gallery[index].Id" type="hidden" />
                                            <div class="border rounded-4 bg-white p-3 h-100">
                                                <label asp-for="Input.Images.Gallery[index].ImageUrl" class="form-label">Imagen de galería @(index + 1)</label>
                                                <div class="admin-product-image-panel mb-3">
                                                    <img src="@ProductImageDefaults.ResolveDisplayUrl(slot.ResolvePreviewUrl())" alt="Previsualización de la imagen de galería @(index + 1)" class="admin-product-preview-image gallery-image-preview" id="galleryPreview_@index" />
                                                </div>
                                                <div class="input-group">
                                                    <input asp-for="Input.Images.Gallery[index].ImageUrl" class="form-control gallery-image-url-input" placeholder="https://... o /images/..." data-preview-target="galleryPreview_@index" />
                                                    <button type="button" class="btn btn-outline-secondary gallery-image-clear-button" data-input-target="Input_Images_Gallery_@(index)__ImageUrl">Limpiar</button>
                                                </div>
                                                <span asp-validation-for="Input.Images.Gallery[index].ImageUrl" class="text-danger small"></span>
                                                <div class="form-text">Mantenga el campo vacío para no usar ese slot.</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <label asp-for="Input.CategoryId" class="form-label mb-0">Categoría principal</label>
                                <a asp-page="/Admin/Categories/Index" class="small text-decoration-none">Administrar categorías</a>
                            </div>
                            <select asp-for="Input.CategoryId" class="form-select" id="categorySelector">
                                <option value="">Seleccione una categoría</option>
                                @foreach (var category in Model.MainCategories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.SubcategoryId" class="form-label">Subcategoría</label>
                            <select asp-for="Input.SubcategoryId" class="form-select" id="subcategorySelector">
                                <option value="">Sin subcategoría</option>
                                @foreach (var subcategory in Model.Subcategories)
                                {
                                    <option value="@subcategory.Id" data-parent-id="@subcategory.ParentCategoryId">@subcategory.Name</option>
                                }
                            </select>
                            <div class="form-text">Solo se permiten subcategorías hijas de la categoría principal seleccionada.</div>
                            <span asp-validation-for="Input.SubcategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Tags" class="form-label">Etiquetas</label>
                            <input asp-for="Input.Tags" class="form-control" placeholder="tag-1, tag-2, tag-3" />
                        </div>
                    </div>

                    @if (Model.Input.IsPhysicalProduct)
                    {
                        <div class="mt-5">
                            <div class="admin-muted-label">Producto físico</div>
                            <h3 class="h5 fw-semibold mt-2 mb-3">Dimensiones y logística</h3>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="Input.WeightKg" class="form-label">Peso (kg)</label>
                                    <input asp-for="Input.WeightKg" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.HeightCm" class="form-label">Alto (cm)</label>
                                    <input asp-for="Input.HeightCm" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.WidthCm" class="form-label">Ancho (cm)</label>
                                    <input asp-for="Input.WidthCm" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Input.LengthCm" class="form-label">Largo (cm)</label>
                                    <input asp-for="Input.LengthCm" class="form-control" />
                                </div>
                                <div class="col-12 form-check mt-2 ms-2">
                                    <input asp-for="Input.RequiresShipping" class="form-check-input" />
                                    <label asp-for="Input.RequiresShipping" class="form-check-label">Requiere envío</label>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.Input.IsDigitalProduct)
                    {
                        <div class="mt-5">
                            <div class="admin-muted-label">Producto digital</div>
                            <h3 class="h5 fw-semibold mt-2 mb-3">Entrega y licencia</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.FileFormat" class="form-label">Formato de archivo</label>
                                    <input asp-for="Input.FileFormat" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.FileSizeMb" class="form-label">Tamaño (MB)</label>
                                    <input asp-for="Input.FileSizeMb" class="form-control" />
                                </div>
                                <div class="col-12 form-check mt-2 ms-2">
                                    <input asp-for="Input.RequiresLicense" class="form-check-input" />
                                    <label asp-for="Input.RequiresLicense" class="form-check-label">Requiere licencia</label>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-5">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Volver al listado</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card admin-summary-card border-0 mb-4">
            <div class="card-body p-4">
                <div class="admin-muted-label">Imagen principal</div>
                <div class="admin-product-image-panel mt-3">
                    <img src="@Model.MainImagePreviewUrl" alt="Vista previa de la imagen principal del producto" class="admin-product-preview-image" id="sidebarMainImagePreview" />
                </div>
                <div class="small text-muted mt-3">La imagen principal se reutiliza en catálogo público, detalle del producto y listados administrativos.</div>
                <div class="small text-muted mt-2">La galería ya admite hasta 3 URLs complementarias persistidas para este MVP.</div>
            </div>
        </div>

        <div class="card admin-summary-card border-0 mb-4">
            <div class="card-body p-4">
                <div class="admin-muted-label">Promoción vigente</div>
                @if (Model.PromotionSummary is null)
                {
                    <h3 class="h6 fw-semibold mt-2 mb-2">Sin promoción activa</h3>
                    <p class="small text-muted mb-0">El producto no tiene un descuento promocional activo en este momento.</p>
                }
                else
                {
                    <h3 class="h6 fw-semibold mt-2 mb-3">Promoción activa</h3>
                    <div class="d-flex flex-column gap-2 small">
                        <div>
                            <div class="text-muted">Precio vigente</div>
                            <div class="fw-semibold text-success">@Model.PromotionSummary.Currency @Model.PromotionSummary.CurrentPrice.ToString("N2")</div>
                        </div>
                        <div>
                            <div class="text-muted">Precio base</div>
                            <div class="fw-semibold text-decoration-line-through">@Model.PromotionSummary.Currency @Model.PromotionSummary.BasePrice.ToString("N2")</div>
                        </div>
                        <div>
                            <div class="text-muted">Descuento aplicado</div>
                            <div class="fw-semibold">@Model.PromotionSummary.CurrentDiscountPercentage?.ToString("N2")%</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card admin-summary-card border-0">
            <div class="card-body p-4">
                <div class="admin-muted-label">Historial promocional</div>
                <h3 class="h6 fw-semibold mt-2 mb-3">Actividad reciente</h3>

                @if (Model.PromotionHistory.Count == 0)
                {
                    <p class="small text-muted mb-0">No se registran eventos promocionales recientes para este producto.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model.PromotionHistory)
                        {
                            <div class="border rounded-4 p-3 bg-light-subtle">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">@item.Action</div>
                                        <div class="small text-muted">@item.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                                    </div>
                                    <span class="badge @(item.IsRemoval ? "text-bg-danger" : "text-bg-success")">
                                        @(item.IsRemoval ? "Restauración" : "Descuento")
                                    </span>
                                </div>
                                <div class="small text-muted mt-2">@item.Detail</div>
                                <div class="small mt-2"><strong>Actor:</strong> @item.PerformedBy</div>
                                @if (item.DiscountPercentage.HasValue)
                                {
                                    <div class="small"><strong>Descuento:</strong> @item.DiscountPercentage.Value.ToString("N2")%</div>
                                }
                                @if (item.FromPrice.HasValue || item.ToPrice.HasValue)
                                {
                                    <div class="small mt-1">
                                        <strong>Precio:</strong>
                                        @(item.Currency ?? Model.Input.Currency) @(item.FromPrice?.ToString("N2") ?? "-")
                                        <span class="mx-1">→</span>
                                        @(item.Currency ?? Model.Input.Currency) @(item.ToPrice?.ToString("N2") ?? "-")
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const categorySelector = document.getElementById('categorySelector');
            const subcategorySelector = document.getElementById('subcategorySelector');
            const mainImageFileInput = document.getElementById('mainImageFileInput');
            const mainImageUrlInput = document.getElementById('mainImageUrlInput');
            const mainImageUrlClearButton = document.getElementById('mainImageUrlClearButton');
            const removeCurrentImageInput = document.getElementById('removeCurrentImageInput');
            const mainImagePreview = document.getElementById('mainImagePreview');
            const sidebarMainImagePreview = document.getElementById('sidebarMainImagePreview');
            const galleryUrlInputs = document.querySelectorAll('.gallery-image-url-input');
            const galleryClearButtons = document.querySelectorAll('.gallery-image-clear-button');
            const defaultPreviewUrl = '@Model.MainImagePreviewUrl';
            const placeholderPreviewUrl = '/images/placeholders/product-placeholder.svg';

            function syncSubcategories() {
                if (!categorySelector || !subcategorySelector) {
                    return;
                }

                const selectedCategoryId = categorySelector.value;
                const subcategoryOptions = Array.from(subcategorySelector.options);

                subcategoryOptions.forEach(option => {
                    if (!option.value) {
                        option.hidden = false;
                        option.disabled = false;
                        return;
                    }

                    const parentCategoryId = option.getAttribute('data-parent-id');
                    const isVisible = !!selectedCategoryId && parentCategoryId === selectedCategoryId;
                    option.hidden = !isVisible;
                    option.disabled = !isVisible;
                });

                const selectedOption = subcategorySelector.selectedOptions[0];
                if (selectedOption && selectedOption.value && selectedOption.disabled) {
                    subcategorySelector.value = '';
                }
            }

            function updateMainImagePreview() {
                const selectedFile = mainImageFileInput?.files?.[0];
                const syncPreview = (imageElement, imageUrl) => {
                    if (imageElement) {
                        imageElement.src = imageUrl;
                    }
                };

                if (selectedFile) {
                    const objectUrl = URL.createObjectURL(selectedFile);
                    syncPreview(mainImagePreview, objectUrl);
                    syncPreview(sidebarMainImagePreview, objectUrl);
                    return;
                }

                if (removeCurrentImageInput?.checked) {
                    syncPreview(mainImagePreview, '/images/placeholders/product-placeholder.svg');
                    syncPreview(sidebarMainImagePreview, '/images/placeholders/product-placeholder.svg');
                    return;
                }

                const externalUrl = mainImageUrlInput?.value?.trim();
                syncPreview(mainImagePreview, externalUrl || defaultPreviewUrl);
                syncPreview(sidebarMainImagePreview, externalUrl || defaultPreviewUrl);
            }

            function updateGalleryPreview(input) {
                const previewTargetId = input?.dataset?.previewTarget;
                if (!previewTargetId) {
                    return;
                }

                const preview = document.getElementById(previewTargetId);
                if (!preview) {
                    return;
                }

                const imageUrl = input.value?.trim();
                preview.src = imageUrl || placeholderPreviewUrl;
            }

            function clearInputById(inputId) {
                const input = document.getElementById(inputId);
                if (!input) {
                    return;
                }

                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }

            categorySelector?.addEventListener('change', syncSubcategories);
            mainImageFileInput?.addEventListener('change', () => {
                if (mainImageFileInput.files?.length) {
                    clearInputById('mainImageUrlInput');
                    if (removeCurrentImageInput) {
                        removeCurrentImageInput.checked = false;
                    }
                }

                updateMainImagePreview();
            });
            mainImageUrlInput?.addEventListener('input', () => {
                if (mainImageUrlInput.value?.trim()) {
                    if (mainImageFileInput) {
                        mainImageFileInput.value = '';
                    }

                    if (removeCurrentImageInput) {
                        removeCurrentImageInput.checked = false;
                    }
                }

                updateMainImagePreview();
            });
            mainImageUrlClearButton?.addEventListener('click', () => clearInputById('mainImageUrlInput'));
            removeCurrentImageInput?.addEventListener('change', updateMainImagePreview);
            galleryUrlInputs.forEach(input => {
                input.addEventListener('input', () => updateGalleryPreview(input));
                updateGalleryPreview(input);
            });
            galleryClearButtons.forEach(button => {
                button.addEventListener('click', () => clearInputById(button.getAttribute('data-input-target')));
            });
            syncSubcategories();
            updateMainImagePreview();
        })();
    </script>
}
