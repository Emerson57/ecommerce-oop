@page
@using PlataformaECommerce.Domain.Enums
@model PlataformaECommerce.Web.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Pedidos";
    ViewData["Subtitle"] = "Listado operativo de pedidos con filtros administrativos y acciones de seguimiento";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success admin-feedback-alert" role="status" aria-live="polite">
        @Model.StatusMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger admin-feedback-alert" role="alert" aria-live="assertive">
        @Model.ErrorMessage
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card admin-summary-card border-0 h-100">
            <div class="card-body p-4">
                <div class="admin-muted-label">Pedidos visibles</div>
                <div class="display-6 fw-bold mt-2">@Model.Orders.Count</div>
                <div class="text-muted small mt-2">Resultado actual después de aplicar filtros operativos.</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card admin-summary-card border-0 h-100">
            <div class="card-body p-4">
                <div class="admin-muted-label">Activos</div>
                <div class="display-6 fw-bold mt-2">@Model.Orders.Count(order => !order.IsFinalized)</div>
                <div class="text-muted small mt-2">Pendientes de cierre o despacho definitivo.</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card admin-summary-card border-0 h-100">
            <div class="card-body p-4">
                <div class="admin-muted-label">Finalizados</div>
                <div class="display-6 fw-bold mt-2">@Model.Orders.Count(order => order.IsFinalized)</div>
                <div class="text-muted small mt-2">Entregados o cancelados dentro del conjunto visible.</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card admin-summary-card border-0 h-100">
            <div class="card-body p-4">
                <div class="admin-muted-label">Monto visible</div>
                <div class="display-6 fw-bold mt-2">@Model.Orders.Sum(order => order.TotalAmount).ToString("N2")</div>
                <div class="text-muted small mt-2">Suma de totales para la vista filtrada actual.</div>
            </div>
        </div>
    </div>
</div>

<div class="card admin-summary-card border-0 mb-4">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div asp-validation-summary="ModelOnly" class="text-danger small col-12"></div>

            <div class="col-md-4 col-xl-2">
                <label asp-for="Status" class="form-label">Estado</label>
                <select asp-for="Status" class="form-select">
                    <option value="">Todos</option>
                    @foreach (EstadoPedido status in Enum.GetValues<EstadoPedido>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>

            <div class="col-md-4 col-xl-2">
                <label asp-for="Condition" class="form-label">Condición</label>
                <select asp-for="Condition" class="form-select">
                    <option value="">Todas</option>
                    <option value="@IndexModel.OrderConditionFilter.Active">Activos</option>
                    <option value="@IndexModel.OrderConditionFilter.Finalized">Finalizados</option>
                </select>
            </div>

            <div class="col-md-4 col-xl-2">
                <label asp-for="CreatedFrom" class="form-label">Desde</label>
                <input asp-for="CreatedFrom" class="form-control" type="date" />
                <span asp-validation-for="CreatedFrom" class="text-danger small"></span>
            </div>

            <div class="col-md-4 col-xl-2">
                <label asp-for="CreatedTo" class="form-label">Hasta</label>
                <input asp-for="CreatedTo" class="form-control" type="date" />
                <span asp-validation-for="CreatedTo" class="text-danger small"></span>
            </div>

            <div class="col-md-4 col-xl-2">
                <label asp-for="MinTotalAmount" class="form-label">Monto mínimo</label>
                <input asp-for="MinTotalAmount" class="form-control" type="number" min="0" step="0.01" />
                <span asp-validation-for="MinTotalAmount" class="text-danger small"></span>
            </div>

            <div class="col-md-4 col-xl-2">
                <label asp-for="MaxTotalAmount" class="form-label">Monto máximo</label>
                <input asp-for="MaxTotalAmount" class="form-control" type="number" min="0" step="0.01" />
                <span asp-validation-for="MaxTotalAmount" class="text-danger small"></span>
            </div>

            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Aplicar filtros</button>
            </div>
            <div class="col-md-auto">
                <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>

        @if (Model.HasActiveFilters)
        {
            <div class="small text-muted mt-3">
                Los filtros permanecen en la URL del backoffice para retomar la misma vista operativa y conservar el pedido seleccionado.
            </div>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
                    <div>
                        <div class="admin-muted-label">Órdenes visibles</div>
                        <h2 class="h5 fw-bold mb-0">Listado administrativo</h2>
                    </div>
                    <span class="badge rounded-pill text-bg-dark">@Model.Orders.Count pedido(s)</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0" aria-describedby="admin-orders-caption">
                        <caption id="admin-orders-caption" class="visually-hidden">
                            Listado administrativo de pedidos con filtros operativos y acciones de seguimiento.
                        </caption>
                        <thead>
                            <tr>
                                <th>Pedido</th>
                                <th>Cliente</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Orders.Count == 0)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="admin-empty-state">
                                        <div class="fw-semibold mb-1">No hay pedidos que coincidan con los filtros actuales.</div>
                                        <div class="text-muted small">Ajusta el estado, el rango de fechas o los montos para ampliar el universo operativo visible en el backoffice.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@order.Id</div>
                                        <div class="text-muted small">@order.ItemsCount línea(s) · @order.TotalUnits unidad(es)</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@order.CustomerId</div>
                                        <div class="text-muted small">@(order.IsFinalized ? "Cuenta con cierre operativo" : "En gestión activa")</div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill @(order.IsFinalized ? "text-bg-secondary" : "text-bg-primary")">@order.StatusLabel</span>
                                    </td>
                                    <td>@order.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")</td>
                                    <td class="fw-semibold">@order.Currency @order.TotalAmount.ToString("N2")</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a asp-page="./Index"
                                               asp-all-route-data="Model.CurrentFilterRouteValues"
                                               asp-route-SelectedOrderId="@order.Id"
                                               class="btn btn-sm btn-outline-dark">
                                                Vista rápida
                                            </a>
                                            <a asp-page="./Details"
                                               asp-route-id="@order.Id"
                                               asp-route-returnUrl="@Url.Page("/Admin/Orders/Index", values: Model.CurrentFilterRouteValues)"
                                               class="btn btn-sm btn-primary">
                                                Gestionar
                                            </a>
                                            <a asp-page="/Admin/Audit/Index"
                                               asp-route-AggregateId="@order.Id"
                                               asp-route-Module="Orders"
                                               class="btn btn-sm btn-outline-secondary">
                                                Auditoría
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <div>
                        <div class="admin-muted-label">Seguimiento puntual</div>
                        <h2 class="h5 fw-bold mb-0">Resumen del pedido</h2>
                    </div>
                    @if (Model.SelectedOrder is not null)
                    {
                        <a asp-page="./Index" asp-all-route-data="Model.CurrentFilterRouteValues" class="btn btn-outline-secondary btn-sm">Quitar selección</a>
                    }
                </div>

                @if (Model.SelectedOrder is null)
                {
                    <div class="admin-empty-state">
                        <div class="fw-semibold mb-1">Selecciona un pedido desde la tabla.</div>
                        <div class="text-muted small">El resumen lateral mostrará estado, modalidad, cliente, hitos principales y contexto logístico para una revisión rápida.</div>
                    </div>
                }
                else
                {
                    <div class="border rounded-3 p-3 bg-light-subtle mb-3">
                        <div class="small text-muted">Identificador</div>
                        <div class="fw-semibold mt-1">@Model.SelectedOrder.Id</div>
                        <div class="text-muted small mt-2">Cliente: @Model.SelectedOrder.CustomerId</div>
                    </div>

                    <div class="border rounded-3 p-3 bg-light-subtle mb-3">
                        <div class="small text-muted">Estado actual</div>
                        <div class="fw-semibold mt-1">@Model.SelectedOrder.StatusLabel</div>
                        <div class="text-muted small mt-2">Modalidad: @Model.SelectedOrder.FulfillmentLabel</div>
                    </div>

                    <div class="border rounded-3 p-3 bg-light-subtle mb-3">
                        <div class="small text-muted">Valor</div>
                        <div class="fw-semibold mt-1">@Model.SelectedOrder.Currency @Model.SelectedOrder.TotalAmount.ToString("N2")</div>
                        <div class="text-muted small mt-2">Creado: @Model.SelectedOrder.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")</div>
                    </div>

                    <div class="border rounded-3 p-3 bg-light-subtle mb-3">
                        <div class="small text-muted">Logística</div>
                        @if (Model.SelectedOrder.HasShippingAddress)
                        {
                            <div class="fw-semibold mt-1">@Model.SelectedOrder.ShippingStreet</div>
                            <div class="text-muted small">@Model.SelectedOrder.ShippingCity, @Model.SelectedOrder.ShippingDepartment</div>
                            <div class="text-muted small">@Model.SelectedOrder.ShippingCountry · CP @Model.SelectedOrder.ShippingPostalCode</div>
                        }
                        else
                        {
                            <div class="text-muted small mt-1">No existe una dirección de envío visible para el pedido seleccionado.</div>
                        }
                    </div>

                    <div class="small text-muted">
                        Confirmado: @(Model.SelectedOrder.ConfirmedAtUtc?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Pendiente")<br />
                        Pagado: @(Model.SelectedOrder.PaidAtUtc?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Pendiente")<br />
                        Enviado: @(Model.SelectedOrder.ShippedAtUtc?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Pendiente")<br />
                        Entregado: @(Model.SelectedOrder.DeliveredAtUtc?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Pendiente")<br />
                        Cancelado: @(Model.SelectedOrder.CancelledAtUtc?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Pendiente")
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SelectedOrder.CancellationReason))
                    {
                        <div class="alert alert-warning small mt-3 mb-0" role="status">
                            Motivo de cancelación: @Model.SelectedOrder.CancellationReason
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}