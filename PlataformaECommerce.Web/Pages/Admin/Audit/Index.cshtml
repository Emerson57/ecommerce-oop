@page
@model PlataformaECommerce.Web.Pages.Admin.Audit.IndexModel
@{
    ViewData["Title"] = "Auditoría administrativa";
    ViewData["Subtitle"] = "Trazabilidad transversal del sistema";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-2">Trazabilidad y auditoría</h1>
            <p class="text-muted mb-0">
                Consulte el <code>audit_trail</code> transversal de productos, usuarios, carritos y pedidos
                aplicando filtros por agregado, actor, correlación y rango temporal.
            </p>
        </div>
        <div class="text-muted small">
            Mostrando <strong>@Model.FirstItemNumber</strong> a <strong>@Model.LastItemNumber</strong> de <strong>@Model.TotalCount</strong> eventos
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6 col-xl-4">
                    <label asp-for="AggregateId" class="form-label">Aggregate Id</label>
                    <input asp-for="AggregateId" class="form-control" placeholder="GUID del agregado" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="AggregateType" class="form-label">Tipo de agregado</label>
                    <input asp-for="AggregateType" class="form-control" placeholder="Product, User, Cart, Order" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="Module" class="form-label">Módulo</label>
                    <input asp-for="Module" class="form-control" placeholder="Products, Users, Cart, Orders" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="Action" class="form-label">Acción</label>
                    <input asp-for="Action" class="form-control" placeholder="order.created, user.activated..." />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="PerformedBy" class="form-label">Actor</label>
                    <input asp-for="PerformedBy" class="form-control" placeholder="Correo o nombre del actor" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="CorrelationId" class="form-label">Correlación</label>
                    <input asp-for="CorrelationId" class="form-control" placeholder="Trace identifier" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="FromUtc" class="form-label">Desde UTC</label>
                    <input asp-for="FromUtc" class="form-control" placeholder="2026-03-15T08:30:00Z" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="ToUtc" class="form-label">Hasta UTC</label>
                    <input asp-for="ToUtc" class="form-control" placeholder="2026-03-18T18:00:00Z" />
                </div>
                <div class="col-md-6 col-xl-4">
                    <label asp-for="PageSize" class="form-label">Tamaño de página</label>
                    <select asp-for="PageSize" class="form-select">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.AuditItems.Count == 0)
            {
                <div class="p-4 text-muted">
                    No se encontraron eventos de auditoría con los criterios suministrados.
                </div>
            }
            else
            {
                <div class="p-3 border-bottom bg-body-tertiary d-flex flex-column flex-lg-row justify-content-between gap-2 small text-muted">
                    <span>Página <strong>@Model.PageNumber</strong> de <strong>@Model.TotalPages</strong></span>
                    <span>Orden cronológico: descendente por fecha</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha UTC</th>
                                <th>Módulo</th>
                                <th>Agregado</th>
                                <th>Acción</th>
                                <th>Actor</th>
                                <th>Correlación</th>
                                <th>Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AuditItems)
                            {
                                <tr>
                                    <td class="text-nowrap">@item.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</td>
                                    <td><span class="badge text-bg-dark">@item.Module</span></td>
                                    <td>
                                        <div class="fw-semibold">@item.AggregateType</div>
                                        <div class="small text-muted">@item.AggregateId</div>
                                    </td>
                                    <td><code>@item.Action</code></td>
                                    <td>
                                        <div>@item.PerformedBy</div>
                                        @if (!string.IsNullOrWhiteSpace(item.PerformedByUserId))
                                        {
                                            <div class="small text-muted">@item.PerformedByUserId</div>
                                        }
                                    </td>
                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(item.CorrelationId) ? "-" : item.CorrelationId)</td>
                                    <td>
                                        <div>@item.Detail</div>
                                        <details class="mt-2">
                                            <summary class="small text-primary">Ver metadatos</summary>
                                            <div class="small text-muted mt-2">
                                                <div><strong>Origen:</strong> @(string.IsNullOrWhiteSpace(item.Source) ? "-" : item.Source)</div>
                                                @if (item.Metadata.Count > 0)
                                                {
                                                    <ul class="mb-0 mt-2 ps-3">
                                                        @foreach (var metadata in item.Metadata.OrderBy(entry => entry.Key))
                                                        {
                                                            <li><strong>@metadata.Key:</strong> @metadata.Value</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <div class="mt-2">Sin metadatos adicionales.</div>
                                                }
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="p-3 border-top">
                        <nav aria-label="Paginación de auditoría">
                            <ul class="pagination pagination-sm flex-wrap mb-0">
                                <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-AggregateId="@Model.AggregateId"
                                       asp-route-AggregateType="@Model.AggregateType"
                                       asp-route-Module="@Model.Module"
                                       asp-route-Action="@Model.Action"
                                       asp-route-PerformedBy="@Model.PerformedBy"
                                       asp-route-CorrelationId="@Model.CorrelationId"
                                       asp-route-FromUtc="@Model.FromUtc"
                                       asp-route-ToUtc="@Model.ToUtc"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-PageNumber="1">Primera</a>
                                </li>
                                <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-AggregateId="@Model.AggregateId"
                                       asp-route-AggregateType="@Model.AggregateType"
                                       asp-route-Module="@Model.Module"
                                       asp-route-Action="@Model.Action"
                                       asp-route-PerformedBy="@Model.PerformedBy"
                                       asp-route-CorrelationId="@Model.CorrelationId"
                                       asp-route-FromUtc="@Model.FromUtc"
                                       asp-route-ToUtc="@Model.ToUtc"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-PageNumber="@(Math.Max(1, Model.PageNumber - 1))">Anterior</a>
                                </li>

                                @foreach (int pageNumber in Model.VisiblePageNumbers)
                                {
                                    <li class="page-item @(pageNumber == Model.PageNumber ? "active" : string.Empty)">
                                        <a class="page-link"
                                           asp-page="./Index"
                                           asp-route-AggregateId="@Model.AggregateId"
                                           asp-route-AggregateType="@Model.AggregateType"
                                           asp-route-Module="@Model.Module"
                                           asp-route-Action="@Model.Action"
                                           asp-route-PerformedBy="@Model.PerformedBy"
                                           asp-route-CorrelationId="@Model.CorrelationId"
                                           asp-route-FromUtc="@Model.FromUtc"
                                           asp-route-ToUtc="@Model.ToUtc"
                                           asp-route-PageSize="@Model.PageSize"
                                           asp-route-PageNumber="@pageNumber">@pageNumber</a>
                                    </li>
                                }

                                <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-AggregateId="@Model.AggregateId"
                                       asp-route-AggregateType="@Model.AggregateType"
                                       asp-route-Module="@Model.Module"
                                       asp-route-Action="@Model.Action"
                                       asp-route-PerformedBy="@Model.PerformedBy"
                                       asp-route-CorrelationId="@Model.CorrelationId"
                                       asp-route-FromUtc="@Model.FromUtc"
                                       asp-route-ToUtc="@Model.ToUtc"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-PageNumber="@(Math.Min(Model.TotalPages, Model.PageNumber + 1))">Siguiente</a>
                                </li>
                                <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-AggregateId="@Model.AggregateId"
                                       asp-route-AggregateType="@Model.AggregateType"
                                       asp-route-Module="@Model.Module"
                                       asp-route-Action="@Model.Action"
                                       asp-route-PerformedBy="@Model.PerformedBy"
                                       asp-route-CorrelationId="@Model.CorrelationId"
                                       asp-route-FromUtc="@Model.FromUtc"
                                       asp-route-ToUtc="@Model.ToUtc"
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-PageNumber="@Model.TotalPages">Última</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>
