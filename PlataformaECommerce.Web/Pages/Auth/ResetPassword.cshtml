@page
@using PlataformaECommerce.Application.Common.Security
@model PlataformaECommerce.Web.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-2">Restablecer contraseña</h1>
                        <p class="text-muted mb-0">
                            Define una nueva contraseña segura para completar el restablecimiento de acceso.
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (!Model.HasRecoveryContext)
                    {
                        <div class="d-grid gap-2">
                            <a asp-page="/Auth/ForgotPassword" class="btn btn-primary">Solicitar un nuevo enlace</a>
                            <a asp-page="/Auth/Login" class="btn btn-outline-secondary">Volver a ingresar</a>
                        </div>
                    }
                    else
                    {
                        <form method="post"
                              novalidate
                              data-reset-password-form
                              data-password-min-length="@PasswordPolicyRules.MinLength"
                              data-password-max-length="@PasswordPolicyRules.MaxLength">
                            <input asp-for="UserId" type="hidden" />
                            <input asp-for="Token" type="hidden" />

                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Input.NewPassword" class="form-label"></label>
                                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" data-reset-password-new />
                                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                                <div class="form-text mt-2" aria-live="polite">
                                    <div class="fw-semibold text-body-secondary mb-2">Requisitos de seguridad</div>
                                    <ul class="list-unstyled small mb-0" data-reset-password-rules>
                                        <li data-password-rule="length" class="text-muted">Debe tener entre 8 y 100 caracteres.</li>
                                        <li data-password-rule="uppercase" class="text-muted">Debe incluir al menos una letra mayúscula.</li>
                                        <li data-password-rule="lowercase" class="text-muted">Debe incluir al menos una letra minúscula.</li>
                                        <li data-password-rule="digit" class="text-muted">Debe incluir al menos un número.</li>
                                        <li data-password-rule="special" class="text-muted">Debe incluir al menos un carácter especial.</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" data-reset-password-confirm />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                                <div class="small text-muted mt-2" data-reset-password-feedback aria-live="polite">
                                    Repite la nueva contraseña para validar coincidencia antes de continuar.
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary" data-reset-password-submit>Restablecer contraseña</button>
                                <a asp-page="/Auth/Login" class="btn btn-outline-secondary">Volver a ingresar</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth/reset-password.js" asp-append-version="true"></script>
}