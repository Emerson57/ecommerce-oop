@page
@model PlataformaECommerce.Web.Pages.Auth.ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmación de correo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-2">Reenviar confirmación de correo</h1>
                        <p class="text-muted mb-0">
                            Solicita un nuevo enlace de activación para completar el acceso de tu cuenta.
                        </p>
                    </div>

                    <div class="alert alert-light border" role="status">
                        <h2 class="h6 fw-semibold mb-2">Antes de continuar</h2>
                        <p class="small text-muted mb-2">
                            Por seguridad, la respuesta será la misma aunque la cuenta no exista o ya haya sido confirmada.
                        </p>
                        <ul class="small text-muted mb-0 ps-3">
                            <li>Verifica que el correo corresponda a la cuenta registrada.</li>
                            <li>Revisa spam o correo no deseado antes de solicitar otro envío.</li>
                            <li>Usa el enlace más reciente si recibes más de un mensaje.</li>
                        </ul>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            @Model.StatusMessage
                        </div>
                    }

                    <form method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="usuario@empresa.com" />
                            <div class="form-text">Ingresa el mismo correo con el que creaste la cuenta.</div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Reenviar confirmación</button>
                            <a asp-page="/Auth/Login" class="btn btn-outline-secondary">Volver al ingreso</a>
                            <a asp-page="/Auth/Register" class="btn btn-outline-primary">Crear cuenta</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
