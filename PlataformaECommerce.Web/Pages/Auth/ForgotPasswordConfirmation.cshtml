@page
@model PlataformaECommerce.Web.Pages.Auth.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Recuperación de acceso";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5 text-center">
                    <h1 class="h3 fw-bold mb-3">Revisa tu correo electrónico</h1>
                    <p class="text-muted mb-4">@(Model.StatusMessage ?? "Si la cuenta existe y está habilitada, enviamos un correo de recuperación con un enlace temporal.")</p>

                    @if (!string.IsNullOrWhiteSpace(Model.DevelopmentResetUrl))
                    {
                        <div class="alert alert-warning text-start" role="alert">
                            <div class="fw-semibold mb-2">Vista previa de desarrollo</div>
                            <div class="small mb-2">En entornos locales controlados puedes abrir directamente el restablecimiento.</div>
                            <a href="@Model.DevelopmentResetUrl" class="alert-link">Abrir enlace temporal</a>
                        </div>
                    }

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-page="/Auth/Login" class="btn btn-primary">Volver al ingreso</a>
                        <a asp-page="/Index" class="btn btn-outline-secondary">Ir al inicio</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
