@page
@model PlataformaECommerce.Web.Pages.Auth.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Solicitud enviada";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-2">Solicitud procesada</h1>
                        <p class="text-muted mb-0">
                            Si la cuenta existe y está habilitada, el sistema generó un enlace temporal para continuar el restablecimiento.
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert alert-success" role="status">
                            @Model.StatusMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.VisibleDevelopmentResetUrl))
                    {
                        <div class="alert alert-warning" role="alert">
                            <div class="fw-semibold mb-2">Vista previa disponible solo en desarrollo</div>
                            <p class="mb-2">Utiliza este enlace temporal para continuar el flujo técnico de recuperación mientras no exista envío de correo real.</p>
                            <a href="@Model.VisibleDevelopmentResetUrl" class="link-dark text-break">@Model.VisibleDevelopmentResetUrl</a>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <a asp-page="/Auth/Login" class="btn btn-primary">Volver a ingresar</a>
                        <a asp-page="/Index" class="btn btn-outline-secondary">Ir al inicio</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>