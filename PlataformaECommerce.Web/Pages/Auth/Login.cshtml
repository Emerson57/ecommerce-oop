@page
@model PlataformaECommerce.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Ingresar con correo electrónico";
    string pendingEmailConfirmationAddress = string.IsNullOrWhiteSpace(Model.PendingEmailConfirmationAddress)
        ? "tu correo registrado"
        : Model.PendingEmailConfirmationAddress;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-2">Ingresar con correo electrónico</h1>
                        <p class="text-muted mb-0">
                            Inicie sesión con el correo electrónico registrado y su contraseña para acceder de forma segura a las funcionalidades disponibles del sistema.
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        @if (Model.CanResendEmailConfirmation)
                        {
                            <div class="alert alert-warning" role="alert">
                                <h2 class="h6 fw-semibold mb-2">Tu cuenta aún no ha confirmado el correo electrónico.</h2>
                                <p class="mb-3">
                                    Antes de ingresar, abre el enlace enviado a <strong>@pendingEmailConfirmationAddress</strong>.
                                    Si no lo recibiste o el enlace expiró, puedes solicitar uno nuevo.
                                </p>

                                <div class="d-grid gap-2 d-sm-flex">
                                    <a asp-page="/Auth/ResendEmailConfirmation" asp-route-email="@Model.PendingEmailConfirmationAddress" class="btn btn-sm btn-warning">Reenviar correo de confirmación</a>
                                    <a asp-page="/Auth/Register" class="btn btn-sm btn-outline-secondary">Crear otra cuenta</a>
                                </div>

                                <div class="form-text mt-3 mb-0 text-dark">
                                    Revisa también la carpeta de spam o correo no deseado antes de solicitar un nuevo envío.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger" role="alert">
                                @Model.ErrorMessage
                            </div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            @Model.StatusMessage
                        </div>
                    }

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="usuario@empresa.com" />
                            <div class="form-text">Usaremos tu correo electrónico como identificador principal de acceso.</div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Ingrese su contraseña" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label">Mantener sesión iniciada</label>
                        </div>

                        <div class="text-end mb-4">
                            <a asp-page="/Auth/ForgotPassword" class="small text-decoration-none">Recuperar acceso por correo</a>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Ingresar</button>
                            <a asp-page="/Auth/Register" class="btn btn-outline-primary">Crear cuenta con correo electrónico</a>
                            <a asp-page="/Index" class="btn btn-outline-secondary">Volver al inicio</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
