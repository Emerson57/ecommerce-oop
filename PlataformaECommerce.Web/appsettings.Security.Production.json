{
  "TransportSecurity": {
    "HstsEnabled": true,
    "HstsMaxAgeDays": 365,
    "IncludeSubDomains": true,
    "Preload": true
  },
  "OpenApiSecurity": {
    "EnabledInDevelopment": false,
    "EnabledInQualityAssurance": false,
    "EnabledInProduction": false,
    "RequireAuthorizationOutsideDevelopment": true,
    "RequiredPolicy": "SuperUserOnly"
  }
}
