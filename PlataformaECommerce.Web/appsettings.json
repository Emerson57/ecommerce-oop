{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PlataformaECommerce.Web.Pages.Auth.LoginModel": "Information",
      "PlataformaECommerce.Web.Authorization.AdminCookieAuthenticationEvents": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithEnvironmentName" ],
    "Properties": {
      "Application": "PlataformaECommerce.Web"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "DataProtection": {
    "ApplicationName": "PlataformaECommerce"
  },
  "MongoDb": {
    "Enabled": true,
    "DatabaseName": "PlataformaECommerceAuditDb",
    "AuditCollectionName": "audit_trail",
    "EnsureIndexesOnStartup": true
  },
  "Payments": {
    "Wompi": {
      "Enabled": false,
      "ProviderName": "Wompi",
      "CheckoutBaseUrl": "https://checkout.wompi.co/p/",
      "TransactionsApiBaseUrl": "https://production.wompi.co/v1/transactions/",
      "UseSandbox": false
    }
  },
  "Notifications": {
    "Smtp": {
      "Enabled": false,
      "Port": 587,
      "EnableSsl": true,
      "FromDisplayName": "Plataforma ECommerce"
    }
  },
  "ClientExperience": {
    "ClientId": "novashop-default",
    "StorefrontName": "NovaShop",
    "BackofficeName": "NovaShop Backoffice",
    "StorefrontTagline": "Compra tecnología, hogar y experiencias digitales con una operación segura, trazable y preparada para crecer.",
    "HomeHeroBadge": "Temporada de ofertas",
    "HomeHeroTitle": "Descubre productos para tecnología, hogar y estilo en una sola experiencia de compra.",
    "HomePromoTitle": "Compra con respaldo operativo, atención clara y promociones semanales.",
    "LegalCompanyName": "NovaShop Commerce",
    "SupportEmail": "support@novashop.example",
    "SupportPhone": "+57 300 000 0000",
    "SupportHours": "Lunes a viernes, 08:00 a 18:00 UTC-5",
    "SupportSla": "Respuesta inicial en menos de 8 horas hábiles.",
    "PrimaryColor": "#111827",
    "AccentColor": "#2563eb",
    "AdminSidebarStartColor": "#0f172a",
    "AdminSidebarEndColor": "#1e293b",
    "LogoGlyph": "N"
  },
  "Jwt": {
    "Issuer": "PlataformaECommerce.Web",
    "Audience": "PlataformaECommerce.Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "RequireHttpsMetadata": true
  },
  "Backoffice": {
    "ProductImages": {
      "UploadsDirectory": "uploads/products",
      "RequestPath": "/uploads/products",
      "MaxFileSizeInBytes": 5242880,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
    },
    "Users": {
      "EnableAdministratorCreationUi": true
    }
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data: https:; connect-src 'self'; form-action 'self'",
    "PermissionsPolicy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "FrameOptions": "DENY",
    "ContentTypeOptions": "nosniff",
    "CrossOriginOpenerPolicy": "same-origin",
    "CrossOriginResourcePolicy": "same-site",
    "IncludeUpgradeInsecureRequests": true
  },
  "RateLimiting": {
    "AuthFlow": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "SensitiveApi": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "PublicApi": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Observability": {
    "CorrelationHeaderName": "X-Correlation-ID",
    "EmitResponseHeader": true,
    "MaxCorrelationIdLength": 128
  },
  "AllowedHosts": "*"
}
