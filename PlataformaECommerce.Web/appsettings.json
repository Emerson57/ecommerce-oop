{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PlataformaECommerce.Web.Initialization.SuperUserBootstrapService": "Information",
      "PlataformaECommerce.Web.Pages.Auth.LoginModel": "Information",
      "PlataformaECommerce.Web.Authorization.AdminCookieAuthenticationEvents": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=PlataformaECommerceDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "PlataformaECommerceAuditDb",
    "AuditCollectionName": "audit_trail",
    "EnsureIndexesOnStartup": true
  },
  "Jwt": {
    "Issuer": "PlataformaECommerce.Web",
    "Audience": "PlataformaECommerce.Clients",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "RequireHttpsMetadata": true
  },
  "Bootstrap": {
    "SuperUser": {
      "Enabled": false,
      "AllowInProduction": false,
      "Name": "",
      "Email": "",
      "Password": "",
      "Area": ""
    }
  },
  "Backoffice": {
    "Users": {
      "EnableAdministratorCreationUi": true
    }
  },
  "AllowedHosts": "*"
}
